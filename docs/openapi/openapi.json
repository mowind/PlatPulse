{
  "openapi": "3.1.0",
  "info": {
    "title": "platpulse-server",
    "description": "PlatPulse central ingestion, projection, and Web asset server",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/admin/v1/agents": {
      "get": {
        "tags": [
          "admin"
        ],
        "operationId": "diagnostics",
        "responses": {
          "200": {
            "description": "Owner-only Agent and Node diagnostics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgentDiagnostic"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/v1/nodes/{node_id}/visibility": {
      "put": {
        "tags": [
          "admin"
        ],
        "summary": "Owner-only visibility mutation. All browser mutation trust-boundary\nchecks are explicit here because Admin DTOs must not be writable by a\nViewer or by cross-origin requests.",
        "operationId": "set_visibility",
        "parameters": [
          {
            "name": "node_id",
            "in": "path",
            "description": "Node ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisibilityRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisibilityResponse"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/v1/enroll": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "Exchange a single-use Enrollment Token for an Agent identity and\ncredential. The token arrives in the `Authorization: Bearer` header —\nnever in a URL or body — and the same token can never enroll twice.",
        "operationId": "enroll_handler",
        "responses": {
          "200": {
            "description": "Enrolled; the response carries the one-time Agent Credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired enrollment token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "The enrollment token was already consumed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too many enrollment attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Server setup is incomplete or the database is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "agent_bearer": []
          }
        ]
      }
    },
    "/api/public/v1/login": {
      "post": {
        "tags": [
          "public"
        ],
        "summary": "Login with strict configured-Origin validation, an independent rate\nlimit, and Session ID rotation (design §12.2–§12.4).",
        "operationId": "login_handler",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Logged in; a session cookie is set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Origin validation failed or the user is disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too many login attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "Server setup is incomplete",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/v1/logout": {
      "post": {
        "tags": [
          "public"
        ],
        "summary": "Logout: revoke the current Session and clear the cookie (design §12.3).\nRevocation and its audit row commit in one transaction; a database\nfailure keeps the session valid and returns 500 instead of pretending\nthe user signed out.",
        "operationId": "logout_handler",
        "responses": {
          "204": {
            "description": "The current session is revoked and its cookie cleared"
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "The session could not be revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/v1/networks": {
      "get": {
        "tags": [
          "public"
        ],
        "summary": "Public Home projection. The query boundary only selects public, active\nNodes and never returns endpoint, Agent, host identity, capacity, or raw\nerrors from the Admin projection.",
        "operationId": "public_networks",
        "responses": {
          "200": {
            "description": "Published Network and Node projection",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PublicNetwork"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/public/v1/networks/{network_key}": {
      "get": {
        "tags": [
          "public"
        ],
        "operationId": "public_network",
        "parameters": [
          {
            "name": "network_key",
            "in": "path",
            "description": "Registered Network key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published Network projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicNetwork"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/v1/nodes/{node_id}": {
      "get": {
        "tags": [
          "public"
        ],
        "operationId": "public_node_detail",
        "parameters": [
          {
            "name": "node_id",
            "in": "path",
            "description": "Published Node ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published Node projection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicNode"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/v1/session": {
      "get": {
        "tags": [
          "public"
        ],
        "summary": "Current session projection and CSRF token for the WebUI (design §12.4).\n`last_seen_at` is refreshed at most once per throttle window.",
        "operationId": "session_handler",
        "responses": {
          "200": {
            "description": "The current session and CSRF token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "live",
        "responses": {
          "200": {
            "description": "Event loop is responding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "Server is ready to serve",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "Server is not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentDiagnostic": {
        "type": "object",
        "required": [
          "agent_id",
          "agent_epoch",
          "clock_status",
          "liveness",
          "capabilities",
          "nodes"
        ],
        "properties": {
          "agent_epoch": {
            "type": "integer",
            "format": "int64"
          },
          "agent_id": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "clock_skew_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "clock_status": {
            "type": "string"
          },
          "host": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/HostDiagnostic"
              }
            ]
          },
          "last_received_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_report_sequence": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "liveness": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NodeDiagnostic"
            }
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "requestId",
          "fields"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "ApiErrorBody": {
        "type": "object",
        "description": "Unified API error envelope (design §13.3): clients depend only on `code`;\n`message` never leaks SQL, RPC URLs, credentials, or stacks; `requestId`\ncorrelates a response with its request log; `fields` carries per-field\nvalidation details when a later ticket adds them.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiError"
          }
        }
      },
      "ComponentDiagnostic": {
        "type": "object",
        "required": [
          "state",
          "state_revision",
          "value_revision"
        ],
        "properties": {
          "attempted_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_message": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "received_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string"
          },
          "state_revision": {
            "type": "integer",
            "format": "int64"
          },
          "value_revision": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ConsensusDiagnostic": {
        "type": "object",
        "required": [
          "state",
          "state_revision",
          "value_revision"
        ],
        "properties": {
          "attempted_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "epoch": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_message": {
            "type": [
              "string",
              "null"
            ]
          },
          "highest_commit_block": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "highest_lock_block": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "highest_qc_block": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "received_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string"
          },
          "state_revision": {
            "type": "integer",
            "format": "int64"
          },
          "validator": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "value_revision": {
            "type": "integer",
            "format": "int64"
          },
          "view_number": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
      "EnrollResponse": {
        "type": "object",
        "description": "Success payload of one Agent Enrollment (Agent wire: snake_case,\ndesign §9.1). `credential` is the full `pp_agent_…` token and is\ndelivered to the enrolling Agent exactly once; the Server stores only\nits pepper-keyed digest.",
        "required": [
          "agent_id",
          "agent_epoch",
          "credential",
          "protocol_version"
        ],
        "properties": {
          "agent_epoch": {
            "type": "integer",
            "format": "int64",
            "description": "Agent Epoch advanced by this Enrollment (1 for a new Agent)."
          },
          "agent_id": {
            "type": "string",
            "description": "Stable Agent identity issued by the Server (UUID)."
          },
          "credential": {
            "type": "string",
            "description": "Full Agent Credential token; single delivery."
          },
          "protocol_version": {
            "type": "integer",
            "format": "int64",
            "description": "Agent→Server protocol major the Server speaks.",
            "minimum": 0
          }
        }
      },
      "HostComponentDiagnostic": {
        "type": "object",
        "required": [
          "component",
          "state",
          "state_revision",
          "value_revision"
        ],
        "properties": {
          "attempted_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "component": {
            "type": "string"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_message": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "received_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string"
          },
          "state_revision": {
            "type": "integer",
            "format": "int64"
          },
          "value_revision": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "HostDiagnostic": {
        "type": "object",
        "required": [
          "updated_at",
          "components"
        ],
        "properties": {
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HostComponentDiagnostic"
            }
          },
          "cpu_percent": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "load1": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "load15": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "load5": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "memory_total_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "memory_used_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "network_rx_bytes_per_sec": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "network_tx_bytes_per_sec": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "LiveResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "NodeDiagnostic": {
        "type": "object",
        "required": [
          "node_id",
          "network_key",
          "lifecycle",
          "inventory_revision",
          "visibility",
          "health",
          "health_reason"
        ],
        "properties": {
          "consensus": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ConsensusDiagnostic"
              }
            ]
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "health": {
            "type": "string"
          },
          "health_reason": {
            "type": "string"
          },
          "inventory_revision": {
            "type": "integer",
            "format": "int64"
          },
          "lifecycle": {
            "type": "string"
          },
          "network_key": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "process": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ProcessDiagnostic"
              }
            ]
          },
          "rpc": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/RpcDiagnostic"
              }
            ]
          },
          "sync": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SyncDiagnostic"
              }
            ]
          },
          "visibility": {
            "type": "string"
          }
        }
      },
      "ProcessDiagnostic": {
        "type": "object",
        "required": [
          "state",
          "state_revision",
          "value_revision"
        ],
        "properties": {
          "attempted_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "cpu_percent": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_message": {
            "type": [
              "string",
              "null"
            ]
          },
          "memory_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "pid": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "received_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string"
          },
          "state_revision": {
            "type": "integer",
            "format": "int64"
          },
          "uptime_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "value_revision": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "PublicNetwork": {
        "type": "object",
        "required": [
          "networkKey",
          "displayName",
          "nodes"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          },
          "networkKey": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicNode"
            }
          }
        }
      },
      "PublicNode": {
        "type": "object",
        "required": [
          "nodeId",
          "networkKey",
          "health",
          "healthReason",
          "rpcState",
          "syncState",
          "consensusState",
          "processState"
        ],
        "properties": {
          "consensusState": {
            "type": "string"
